<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚨" android:textSize="72sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALERT NEEDS ATTENTION" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="16dp"/>
<TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Event was not acknowledged." android:textSize="18sp" android:gravity="center" android:layout_marginTop="16dp"/>
<Button android:id="@+id/ack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ACKNOWLEDGE &amp; STOP" android:layout_marginTop="32dp"/>
</LinearLayout>
